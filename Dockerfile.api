FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
COPY app ./app

RUN pip install --no-cache-dir .

RUN useradd --create-home --shell /bin/bash linpo \
    && mkdir -p /data \
    && chown -R linpo:linpo /app /data

USER linpo

ENV LINPO_DATABASE_URL=sqlite:////data/linpo.db

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
