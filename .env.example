# Linpo backend (minimal for OSS single-instance)
LINPO_SECRET_ENCRYPTION_KEY=replace-with-32-byte-base64-key
LINPO_ALLOW_LOOPBACK_ENDPOINTS=true
LINPO_ALLOW_PRIVATE_ENDPOINTS=true

# OpenClaw runtime
OPENCLAW_BASE_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=replace-with-openclaw-gateway-token
LINPO_CORS_ALLOW_ORIGINS=http://localhost:5173

# Optional: override planner agent, default is planner-default.
# FLOW_DECOMPOSITION_AGENT_ID=planner-default
# Optional: OPENCLAW_ORIGIN (fallback derives from OPENCLAW_BASE_URL).
# OPENCLAW_ORIGIN=http://127.0.0.1:18789
# Optional: callback base url, default is http://localhost:8000.
# LINPO_TASK_EVENT_CALLBACK_BASE_URL=http://localhost:8000
