# Linpo backend
LINPO_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:40193/linpo
LINPO_SECRET_ENCRYPTION_KEY=replace-with-32-byte-base64-key
LINPO_CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# OpenClaw default runtime (claw1)
OPENCLAW_BASE_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=replace-with-openclaw-gateway-token
OPENCLAW_ORIGIN=http://127.0.0.1:18789

# Flow decomposition service runtime
FLOW_DECOMPOSITION_PROVIDER=openclaw
FLOW_DECOMPOSITION_OPENCLAW_BASE_URL=ws://127.0.0.1:38789
FLOW_DECOMPOSITION_OPENCLAW_GATEWAY_TOKEN=replace-with-flow-decomposition-gateway-token
FLOW_DECOMPOSITION_OPENCLAW_ORIGIN=http://127.0.0.1:38789
FLOW_DECOMPOSITION_AGENT_ID=claw3
# 必填；留空时任务投放会失败，且 /api/v1/ops/setup 会报告缺失
LINPO_TASK_EVENT_CALLBACK_BASE_URL=
LINPO_TASK_RUN_STALE_SECONDS=900
LINPO_PAIRING_RECEIPT_TTL_SECONDS=1800
LINPO_PAIRING_ATTACH_BY_CODE_RATE_LIMIT_WINDOW_SECONDS=60
LINPO_PAIRING_ATTACH_BY_CODE_RATE_LIMIT_MAX_FAILURES=8

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
